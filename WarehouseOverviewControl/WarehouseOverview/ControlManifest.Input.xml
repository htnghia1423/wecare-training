<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="Wecare" constructor="WarehouseOverview" version="0.0.1" display-name-key="WarehouseOverview" description-key="WarehouseOverview description" control-type="virtual" >
    <!--external-service-usage node declares whether this 3rd party PCF control is using external service or not, if yes, this control will be considered as premium and please also add the external domain it is using.
    If it is not using any external service, please set the enabled="false" and DO NOT add any domain below. The "enabled" will be false by default.
    Example1:
      <external-service-usage enabled="true">
        <domain>www.Microsoft.com</domain>
      </external-service-usage>
    Example2:
      <external-service-usage enabled="false">
      </external-service-usage>
    -->
    <external-service-usage enabled="false">
      <!--UNCOMMENT TO ADD EXTERNAL DOMAINS
      <domain></domain>
      <domain></domain>
      -->
    </external-service-usage>
    <!-- Dataset nhận bảng tồn kho từ Dataverse -->
    <data-set name="warehouseItems" display-name-key="warehouseItems_Display_Key" cds-data-set-options="displayCommandBar:true;displayViewSelector:false;displayQuickFind:false">
      <property-set name="htn1423_name"        display-name-key="Mã tồn kho"    description-key="Mã tồn kho"      of-type="SingleLine.Text" usage="bound" required="true" />
      <property-set name="htn1423_tensanpham"  display-name-key="Tên sản phẩm"  description-key="Tên sản phẩm"    of-type="Lookup.Simple" usage="bound" required="true" />
      <property-set name="htn1423_tonthucte"   display-name-key="Tồn thực tế"   description-key="Tồn thực tế"     of-type="Decimal"       usage="bound" required="false" />
      <property-set name="htn1423_onvichuan"   display-name-key="Đơn vị chuẩn"  description-key="Đơn vị chuẩn"    of-type="SingleLine.Text" usage="bound" required="false" />
      <property-set name="htn1423_nhomsanpham" display-name-key="Nhóm sản phẩm" description-key="Nhóm sản phẩm"   of-type="SingleLine.Text" usage="bound" required="false" />
      <property-set name="ownerid"             display-name-key="Người quản lý"  description-key="Người quản lý"   of-type="Lookup.Owner"           usage="bound" required="false" />
      <property-set name="modifiedon"          display-name-key="Ngày cập nhật" description-key="Ngày cập nhật"   of-type="DateAndTime.DateAndTime" usage="bound" required="false" />
    </data-set>

    <!-- Input property: ngưỡng cảnh báo tồn thấp -->
    <property name="lowStockThreshold"
      display-name-key="prop_lowStockThreshold"
      description-key="prop_lowStockThreshold_desc"
      of-type="Whole.None"
      usage="input"
      required="false"
      default-value="10" />
    <resources>
      <code path="index.ts" order="1"/>
      <platform-library name="React" version="16.14.0" />
      <css path="WarehouseOverview.css" order="1" />
    </resources>
    <feature-usage>
      <uses-feature name="Utility" required="true" />
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
  </control>
</manifest>
